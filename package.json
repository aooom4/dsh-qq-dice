{
  "name": "dsh-qq-dice",
  "version": "1.2.2",
  "description": "QQ 投骰进度（dsh-qq-dice）：DSH 设置里的独立栏目，展示投骰进度、平均投多少次命中一次，并可直接改参数即时生效。不随 dsh-qq-bridge 更新而回退。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq-bridge",
    "dice",
    "proactive"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "local.config.example.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
